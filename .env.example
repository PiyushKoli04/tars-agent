# Local-only settings for NewsCard Studio.
#
# Copy this file to .env and fill in only the providers you use:
#
#   Copy-Item .env.example .env
#   notepad .env
#
# .env is gitignored. Never commit real credentials. GitHub Actions uses
# repository secrets instead; values already present in the environment
# always take precedence over this file.

# --- Text providers (optional) ---
# The rule-based editor works without any text provider.
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1

OPENCODE_API_KEY=
OPENCODE_MODEL=
# Required when using OpenCode; there is no default endpoint.
OPENCODE_BASE_URL=

GEMINI_API_KEY=
GEMINI_MODEL=
# GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

GROQ_API_KEY=
GROQ_MODEL=
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# --- Image providers (optional) ---
# The generated background is always available without a key.
UNSPLASH_ACCESS_KEY=TElJe50r3kYd9JyCTuxIfS-irP0hNEBvgq4xgtU-ros
PIXABAY_API_KEY=

# --- Instagram (optional locally) ---
# The pipeline automatically reads the gitignored ig_session.json created by
# tools/get_session.py. Leave this blank when using that file. If you paste the
# session JSON here instead, keep it on one line.
IG_SESSION_JSON=

# Optional only for a one-time session refresh. Normal runs never use these.
IG_USERNAME=
IG_PASSWORD=

# --- Local runtime overrides (optional) ---
# Leave blank to auto-detect Chrome.
CHROME_PATH=
# Set this only for isolated local tests, for example to a temp folder.
NEWSCARD_ROOT=
# Local runs must not try to commit status updates.
NEWSCARD_STATUS_PUSH=0
# Set to 0 only for a controlled test of Instagram publishing.
# NEWSCARD_POST_DELAY_SECONDS=0
